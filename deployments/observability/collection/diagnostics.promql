# Read-only diagnostics. Each query yields conflict counts, not business values.
# Duplicate physical raw sources: nonempty is a deployment failure.
count by (ani_cluster_id, namespace, pod_uid, runtime_container_id, container) (ani:instance:cpu_source and (timestamp(ani:instance:cpu_source) == time())) > 1
count by (ani_cluster_id, namespace, pod_uid, runtime_container_id, container) (ani:instance:memory_source and (timestamp(ani:instance:memory_source) == time())) > 1
# Conflicting current CID, duplicated KSM source or conflicting owner labels.
count by (ani_cluster_id, namespace, pod_uid, container) (ani:instance:info_source and (timestamp(ani:instance:info_source) == time())) > 1
count by (ani_cluster_id, namespace, pod_uid, container) (ani:instance:running_source and (timestamp(ani:instance:running_source) == time())) > 1
count by (ani_cluster_id, namespace, pod_uid) (ani:instance:labels_source and (timestamp(ani:instance:labels_source) == time())) > 1
# Raw freshness; values above 45 cannot contribute.
time() - timestamp(container_cpu_usage_seconds_total{container="workspace",cpu="total"})
time() - timestamp(container_memory_working_set_bytes{container="workspace"})
time() - timestamp(kube_pod_container_info{container="workspace"})
time() - timestamp(kube_pod_container_status_running{container="workspace"})
time() - timestamp(kube_pod_labels{label_ani_io_instance_id!=""})
# Unknown/invalid cgroup paths are rejected rather than matched by Pod name.
container_cpu_usage_seconds_total{container="workspace",cpu="total",id!~"/kubepods\\.slice/(?:kubepods-(?:besteffort|burstable)\\.slice/)?kubepods(?:-(?:besteffort|burstable))?-pod[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{12}\\.slice/cri-containerd-[0-9a-f]{64}\\.scope|/kubepods/(?:besteffort/|burstable/)?pod[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{64}"}
kube_pod_container_info{container="workspace",container_id!~"containerd://[0-9a-f]{64}"}
# Current cAdvisor identities lacking matching KSM runtime identity.
(ani:instance:cpu_source and (timestamp(ani:instance:cpu_source) == time())) unless on (ani_cluster_id,namespace,pod,pod_uid,runtime_container_id,container) (ani:instance:binding and (timestamp(ani:instance:binding) == time()))
# Network helpers are Pod-level and carry no runtime_container_id/container, so the
# identity-unless guard must use the 4-key group; a 6-key on() would never match and
# would falsely report every series.
count by (ani_cluster_id, namespace, pod, pod_uid) (ani:instance:network_receive_source and (timestamp(ani:instance:network_receive_source) == time())) > 1
count by (ani_cluster_id, namespace, pod, pod_uid) (ani:instance:network_transmit_source and (timestamp(ani:instance:network_transmit_source) == time())) > 1
time() - timestamp(container_network_receive_bytes_total{interface="eth0"})
time() - timestamp(container_network_transmit_bytes_total{interface="eth0"})
container_network_receive_bytes_total{interface="eth0",id!~"/kubepods\\.slice/(?:kubepods-(?:besteffort|burstable)\\.slice/)?kubepods(?:-(?:besteffort|burstable))?-pod[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{12}\\.slice/cri-containerd-[0-9a-f]{64}\\.scope|/kubepods/(?:besteffort/|burstable/)?pod[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{64}"}
container_network_transmit_bytes_total{interface="eth0",id!~"/kubepods\\.slice/(?:kubepods-(?:besteffort|burstable)\\.slice/)?kubepods(?:-(?:besteffort|burstable))?-pod[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{12}\\.slice/cri-containerd-[0-9a-f]{64}\\.scope|/kubepods/(?:besteffort/|burstable/)?pod[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{64}"}
(ani:instance:network_receive_source and (timestamp(ani:instance:network_receive_source) == time())) unless on (ani_cluster_id,namespace,pod,pod_uid) (ani:instance:binding and (timestamp(ani:instance:binding) == time()))
(ani:instance:network_transmit_source and (timestamp(ani:instance:network_transmit_source) == time())) unless on (ani_cluster_id,namespace,pod,pod_uid) (ani:instance:binding and (timestamp(ani:instance:binding) == time()))
